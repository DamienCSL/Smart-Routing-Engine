# Legacy Supabase demo (optional — leave blank for Driver API mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# IPOSB Driver API — PHP deploy pack (MySQL master)
USE_DRIVER_API=true
# Local PHP (deploy/ with router.php):
DRIVER_API_URL=http://127.0.0.1:8080/api
# Android emulator → use http://10.0.2.2:8080/api instead of 127.0.0.1
# Railway example: https://YOUR-DOMAIN/api
DEMO_DRIVER_UID=demo-driver-kk
DISPATCH_API_KEY=iposb-dispatch-dev-key

# Demo logins (after sql/003_mobile_api_complete.sql):
# customer@iposb.demo / customer123
# driver@iposb.demo / driver123
# demo@iposb.demo / any → legacy Bearer demo:DEMO_DRIVER_UID

# Set true when google-services / Firebase options are added
USE_FIREBASE=false
