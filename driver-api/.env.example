# IPOSB Driver API
PORT=3080
DEMO_AUTH=true

# MySQL — local defaults
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bbbexpress

# Railway / production (preferred names — same as deploy/ PHP)
# BBBEXPRESS_DB_HOST=
# BBBEXPRESS_DB_PORT=3306
# BBBEXPRESS_DB_USER=
# BBBEXPRESS_DB_PASS=
# BBBEXPRESS_DB_NAME=bbbexpress

# Firebase (optional when DEMO_AUTH=true)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Shared secret for Flutter demo desk + web assign
DISPATCH_API_KEY=iposb-dispatch-dev-key
